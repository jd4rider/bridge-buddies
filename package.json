{
  "name": "bridge-buddies",
  "private": true,
  "version": "0.1.0",
  "description": "Build a bridge, test it, get your little buddies across. A miniature 3D bridge-engineering puzzle.",
  "author": "jd4rider",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:levels": "tsx scripts/validate-levels.ts",
    "check": "npm run test && npm run check:levels && npm run build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.33.2",
    "@babylonjs/havok": "^1.3.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
